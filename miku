
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hatsune Miku Snake</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: #101820;
      color: white;
      font-family: Arial, sans-serif;
    }

    h1 {
      color: #55e878;
      margin-bottom: 8px;
    }

    .scoreboard {
      display: flex;
      justify-content: space-between;
      width: min(400px, 92vw);
      margin: 12px 0;
      font-size: 18px;
    }

    canvas {
      width: min(400px, 92vw);
      height: auto;
      border: 3px solid #55e878;
      border-radius: 8px;
      background: #18252e;
    }

    button {
      margin-top: 18px;
      padding: 12px 28px;
      border: none;
      border-radius: 8px;
      background: #55e878;
      color: #101820;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #38c95c;
    }

    p {
      color: #b8c6cf;
      text-align: center;
      padding: 0 12px;
    }
  </style>
</head>
<body>
  <h1>Hatsune Miku Snake</h1>

  <div class="scoreboard">
    <span>Score: <span id="score">0</span></span>
    <span>Best: <span id="best">0</span></span>
  </div>

  <canvas id="game" width="400" height="400"></canvas>

  <button id="startBtn">Start Game</button>
    <p>Use the arrow keys or WASD to move.<br>
      Collect leeks and avoid walls and yourself!</p>

  <script>
    const canvas = document.getElementById("game");
    const ctx = canvas.getContext("2d");
    const scoreDisplay = document.getElementById("score");
    const bestDisplay = document.getElementById("best");
    const startBtn = document.getElementById("startBtn");

    const tile = 20;
    const tiles = canvas.width / tile;

    let snake, food, dx, dy, nextDx, nextDy;
    let score = 0;
    let best = 0;
    let running = false;
    let gameOver = false;
    let timer = null;

    function resetGame() {
      snake = [
        { x: 10, y: 10 },
        { x: 9, y: 10 },
        { x: 8, y: 10 }
      ];

      dx = 1;
      dy = 0;
      nextDx = 1;
      nextDy = 0;
      score = 0;
      gameOver = false;
      running = true;

      scoreDisplay.textContent = score;
      startBtn.textContent = "Restart Game";
      placeFood();
      draw();
      clearInterval(timer);
      timer = setInterval(update, 110);
    }

    function placeFood() {
      do {
        food = {
          x: Math.floor(Math.random() * tiles),
          y: Math.floor(Math.random() * tiles)
        };
      } while (snake.some(
        part => part.x === food.x && part.y === food.y
      ));
    }

    function update() {
      if (!running) return;

      dx = nextDx;
      dy = nextDy;

      const head = {
        x: snake[0].x + dx,
        y: snake[0].y + dy
      };

      const eating = head.x === food.x && head.y === food.y;

      // The tail moves away unless food is eaten.
      const body = eating ? snake : snake.slice(0, -1);

      const hitWall =
        head.x < 0 || head.x >= tiles ||
        head.y < 0 || head.y >= tiles;

      const hitSelf = body.some(
        part => part.x === head.x && part.y === head.y
      );

      if (hitWall || hitSelf) {
        endGame();
        return;
      }

      snake.unshift(head);

      if (eating) {
        score += 1;
        scoreDisplay.textContent = score;
        best = Math.max(best, score);
        bestDisplay.textContent = best;
        placeFood();
      } else {
        snake.pop();
      }

      draw();
    }

    function draw() {
      ctx.fillStyle = "#18252e";
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Subtle grid
      ctx.strokeStyle = "#22333d";
      ctx.lineWidth = 1;

      for (let i = 0; i <= tiles; i++) {
        ctx.beginPath();
        ctx.moveTo(i * tile, 0);
        ctx.lineTo(i * tile, canvas.height);
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(0, i * tile);
        ctx.lineTo(canvas.width, i * tile);
        ctx.stroke();
      }

      drawLeek();

      // Miku's twin tails trail behind her in the direction of travel.
      snake.forEach((part, index) => {
        if (index === 0) return;
        ctx.fillStyle = index % 2 === 0 ? "#20c7bd" : "#31ded0";
        ctx.fillRect(
          part.x * tile + 2,
          part.y * tile + 2,
          tile - 4,
          tile - 4
        );
        ctx.fillStyle = "#f3f4f2";
        ctx.fillRect(part.x * tile + 5, part.y * tile + 7, 3, 2);
        ctx.fillRect(part.x * tile + 12, part.y * tile + 7, 3, 2);
      });

      drawMikuHead();

      if (gameOver) {
        ctx.fillStyle = "rgba(0, 0, 0, 0.7)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.fillStyle = "white";
        ctx.textAlign = "center";
        ctx.font = "bold 32px Arial";
        ctx.fillText("Game Over!", 200, 185);

        ctx.font = "18px Arial";
        ctx.fillText(`Final Score: ${score}`, 200, 220);
      }
    }

    function drawLeek() {
      const centerX = food.x * tile + tile / 2;
      const centerY = food.y * tile + tile / 2;

      ctx.save();
      ctx.translate(centerX, centerY);
      ctx.rotate(-Math.PI / 4);
      ctx.fillStyle = "#f5f5ed";
      ctx.fillRect(-3, -5, 6, 12);
      ctx.fillStyle = "#48c878";
      ctx.fillRect(-3, -9, 2, 6);
      ctx.fillRect(0, -10, 2, 7);
      ctx.fillRect(2, -8, 2, 5);
      ctx.restore();
    }

    function drawMikuHead() {
      const centerX = snake[0].x * tile + tile / 2;
      const centerY = snake[0].y * tile + tile / 2;
      const angle = Math.atan2(dy, dx) + Math.PI / 2;

      ctx.save();
      ctx.translate(centerX, centerY);
      ctx.rotate(angle);

      // Twin tails, hair, and face are drawn in a local forward-facing frame.
      ctx.fillStyle = "#16bdb5";
      ctx.fillRect(-9, -2, 4, 10);
      ctx.fillRect(5, -2, 4, 10);
      ctx.fillStyle = "#e64b79";
      ctx.fillRect(-10, 3, 6, 2);
      ctx.fillRect(4, 3, 6, 2);

      ctx.fillStyle = "#20cfc5";
      ctx.fillRect(-8, -8, 16, 13);
      ctx.fillStyle = "#f5d7c8";
      ctx.fillRect(-6, -5, 12, 9);

      // Long bangs and Miku's signature hair clips.
      ctx.fillStyle = "#16bdb5";
      ctx.fillRect(-7, -8, 5, 5);
      ctx.fillRect(2, -8, 5, 4);
      ctx.fillStyle = "#e64b79";
      ctx.fillRect(-8, -6, 2, 4);
      ctx.fillRect(6, -6, 2, 4);
      ctx.fillStyle = "#276a80";
      ctx.fillRect(-4, -1, 2, 3);
      ctx.fillRect(3, -1, 2, 3);
      ctx.restore();
    }

    function endGame() {
      running = false;
      gameOver = true;
      clearInterval(timer);
      startBtn.textContent = "Play Again";
      draw();
    }

    document.addEventListener("keydown", event => {
      const key = event.key.toLowerCase();
      const keys = [
        "arrowup", "arrowdown", "arrowleft", "arrowright",
        "w", "a", "s", "d", " "
      ];

      if (keys.includes(key)) event.preventDefault();

      if (key === " " && !running) {
        resetGame();
        return;
      }

      if (!running) return;

      // Prevent reversing directly into yourself.
      if ((key === "arrowup" || key === "w") && dy !== 1) {
        nextDx = 0;
        nextDy = -1;
      } else if (
        (key === "arrowdown" || key === "s") && dy !== -1
      ) {
        nextDx = 0;
        nextDy = 1;
      } else if (
        (key === "arrowleft" || key === "a") && dx !== 1
      ) {
        nextDx = -1;
        nextDy = 0;
      } else if (
        (key === "arrowright" || key === "d") && dx !== -1
      ) {
        nextDx = 1;
        nextDy = 0;
      }
    });

    startBtn.addEventListener("click", resetGame);

    // Initial screen
    snake = [
      { x: 10, y: 10 },
      { x: 9, y: 10 },
      { x: 8, y: 10 }
    ];
    food = { x: 15, y: 10 };
    dx = 1;
    dy = 0;
    nextDx = 1;
    nextDy = 0;

    draw();
  </script>
</body>
</html>
